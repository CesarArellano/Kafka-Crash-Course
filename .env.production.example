# Production-style run — talks to the SASL_PLAINTEXT / SCRAM-SHA-256 listener on
# port 9094. Copy this file to .env.production (already gitignored), then run
# scripts/generate-production-credentials.sh, which creates a real SCRAM user on
# the broker and fills in KAFKA_SASL_PASSWORD for you. Never hand-write a
# password into this file.
APP_ENV=production

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
KAFKA_SASL_MECHANISM=SCRAM-SHA-256
KAFKA_SASL_USERNAME=orders-service
KAFKA_SASL_PASSWORD=

ORDERS_TOPIC=orders
ORDERS_DLQ_TOPIC=orders-dlq
ORDERS_CONSUMER_GROUP=order-tracker
