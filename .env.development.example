# Local development — talks to the unauthenticated PLAINTEXT listener started by
# `docker compose up -d`. These values match docker-compose.yaml's defaults, so
# copying this file to .env.development (already gitignored) works unmodified.
APP_ENV=development

KAFKA_BOOTSTRAP_SERVERS=localhost:9092

ORDERS_TOPIC=orders
ORDERS_DLQ_TOPIC=orders-dlq
ORDERS_CONSUMER_GROUP=order-tracker
